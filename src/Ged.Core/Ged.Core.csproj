<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ged.Core</RootNamespace>
    <AssemblyName>Ged.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <!-- Assimp (native, BSD-3) via the MIT Silk.NET binding: FBX / glTF / DAE mesh import. -->
    <PackageReference Include="Silk.NET.Assimp" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped Lua modules for ged.import (scripts/lib/*.lua is the source of truth; the embedded
         copy always wins over a file seeded into a user's scripts folder). -->
    <EmbeddedResource Include="..\..\scripts\lib\*.lua" LogicalName="Ged.Core.Scripting.Lib.%(Filename).lua" />
    <!-- The shipped corpus norms (aggregates only; regenerated by the corpus aggregate promote command). -->
    <EmbeddedResource Include="Analysis\corpus-norms.json" LogicalName="Ged.Core.Analysis.corpus-norms.json" />
    <!-- The design grader's threshold table (DESIGN-QUALITY-SPEC §(d); calibrated against the exemplar study). -->
    <EmbeddedResource Include="Spatial\design-grader.json" LogicalName="Ged.Core.Spatial.design-grader.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The raw selection primitives on EditorDocument/BrushEditor are internal so that only
         SelectionRouter (this assembly) can mutate selection. Test assemblies drive those
         primitives + the router directly. -->
    <InternalsVisibleTo Include="Ged.Core.Tests" />
    <InternalsVisibleTo Include="Ged.App.Tests" />
    <InternalsVisibleTo Include="Ged.Rendering.Tests" />
  </ItemGroup>

</Project>
