<Project>
  <PropertyGroup>
    <!-- Pinned to C# 12 (net8.0's default) so the repo compiles identically on ANY SDK >= 8, not just
         SDK 8. Under "latest", a newer SDK (C# 13+) applies first-class span conversions that re-bind
         LINQ-intent extension calls on arrays to in-place MemoryExtensions overloads — e.g. an array's
         `.Reverse()` binds to the VOID `MemoryExtensions.Reverse(Span<T>)` instead of
         `Enumerable.Reverse`, which fails `foreach (... in arr.Reverse())` with CS1579. Pinning the
         language version keeps binding deterministic; a deliberate future bump must re-audit those
         call sites (they are written as explicit `Enumerable.Reverse(...)` to stay unambiguous). -->
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Assembly / package metadata set centrally so the shipped Glacier.exe VersionInfo
       carries them. Company is the org (FactionFiles); the assembly's LegalCopyright comes
       from Copyright. Product/ProductName stays "Glacier" (set per-project in Ged.App.csproj,
       since the executable carries the product name while the code tree keeps Ged/GED).
       Without an explicit Company the .NET SDK falls back to the assembly name, which is why
       the exe previously reported CompanyName=Glacier. -->
  <PropertyGroup>
    <Company>FactionFiles</Company>
    <Copyright>Copyright (c) 2026 Chris "Goober" Parsons</Copyright>
  </PropertyGroup>

  <!-- Shipping-build source-path hygiene (owner-PC scrub for distributed beta builds).
       The single-file publish (tools/package.ps1 sets PublishSingleFile=true) bundles the
       managed assemblies; without this, each assembly's PE debug directory embeds the
       packager's local .pdb path (e.g. C:\path\to\repo\obj\...\X.pdb), and source-file
       paths would leak into any embedded PDB, [CallerFilePath] strings and exception stack
       traces. PathMap rewrites the repo-root prefix to a neutral "/_/" token so none of the
       packager's local filesystem layout ships inside the binary. Scoped to the single-file
       publish so ordinary local Debug/Release builds keep real paths for debugging.
       DebugType=portable keeps the .pdb external (package.ps1 strips it before packaging), so
       no full-path .pdb ships and no debug symbols ride inside the bundle. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <DebugType>portable</DebugType>
  </PropertyGroup>
</Project>
