<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Diagnostic smoke harness; keep it lenient so it never blocks the main build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ged.App\Ged.App.csproj" />
    <ProjectReference Include="..\..\src\Ged.Rendering\Ged.Rendering.csproj" />
    <ProjectReference Include="..\..\src\Ged.Core\Ged.Core.csproj" />
  </ItemGroup>

</Project>
